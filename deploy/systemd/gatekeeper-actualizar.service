[Unit]
Description=Gatekeeper: despliega la imagen nueva de GHCR si cambió (pull con rollback)
Documentation=file:///opt/gatekeeper/actualizar.sh
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/gatekeeper/actualizar.sh
TimeoutStartSec=15min
# Como root: hablar con Docker equivale a ser root, y un usuario en el grupo docker lo sería igual.
# Lo de abajo acota lo que el propio script puede tocar del sistema.
Environment=DOCKER_CONFIG=%S/gatekeeper/docker
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/var/lib/gatekeeper /var/log/gatekeeper
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
